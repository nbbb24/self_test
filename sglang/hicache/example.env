# =============================================================================
# SGLang HiCache L2/L3 Test Configuration Example
# =============================================================================
#
# Quick start:
#   cp sglang/hicache/example.env sglang/hicache/local.env
#   # Edit local.env, then run:
#   CONFIG_FILE=sglang/hicache/local.env \
#     bash sglang/hicache/run_npu_memcache_l2_l3.sh a3
#
# Keep this file free of credentials. The launcher exports all values loaded
# from CONFIG_FILE to the SGLang and MemCache child processes.


# =============================================================================
# REQUIRED MACHINE SETTINGS
# =============================================================================

MODEL_PATH=/home/weights/Qwen3-32B-W8A8

# Use a local address reachable by MemFabric. Loopback may not be valid for
# device transports on every machine.
PREFILL_MF_STORE_URL=tcp://127.0.0.1:31001
DECODE_MF_STORE_URL=tcp://127.0.0.1:31001


# =============================================================================
# NPU PLACEMENT
# =============================================================================

PREFILL_DEVICES=12,13
DECODE_DEVICES=14,15
TP_SIZE=2


# =============================================================================
# TRANSPORTS
# =============================================================================

# Prefill -> Decode transfer. This is independent from HiCache L2/L3.
PD_PROTOCOL=device_rdma

# Leave MEMCACHE_PROTOCOL unset to use the hardware-profile default:
#   a3 -> device_sdma
#   a5 -> device_urma
# MEMCACHE_PROTOCOL=device_sdma


# =============================================================================
# CACHE CAPACITY
# =============================================================================

HICACHE_SIZE_GB=4
MEMCACHE_DRAM_SIZE=8GB
MEMCACHE_MAX_DRAM_SIZE=256GB
MEMCACHE_WORLD_SIZE=256


# =============================================================================
# PORTS AND OUTPUT
# =============================================================================

PREFILL_PORT=30000
DECODE_PORT=40000
ROUTER_PORT=8000
BOOTSTRAP_PORT=31000
LOG_DIR=/home/sxy/logs/sglang-hicache


# =============================================================================
# OPTIONAL CONTROLS
# =============================================================================

SERVED_MODEL_NAME=qwen
STARTUP_TIMEOUT=1200
KEEP_SERVERS=0
DRY_RUN=0
